NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Atlas connection information
# Replace the username, password and cluster hostname.
MONGODB_URI=mongodb+srv://lms_app_user:ENCODED_PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=FlutterLMS
MONGODB_DB_NAME=flutter_lms
MONGODB_MAX_POOL_SIZE=10

CORS_ORIGINS=*
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=10000

BCRYPT_ROUNDS=12

JWT_ACCESS_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=GENERATE_ANOTHER_LONG_RANDOM_SECRET
JWT_PASSWORD_RESET_SECRET=GENERATE_ANOTHER_LONG_RANDOM_SECRET

JWT_ISSUER=flutter-lms-backend
JWT_AUDIENCE=flutter-lms-mobile
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_PASSWORD_RESET_EXPIRES_IN=10m

OTP_PEPPER=GENERATE_ANOTHER_LONG_RANDOM_SECRET
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Set false during early development.
# OTP codes will be printed in the development logs.
EMAIL_ENABLED=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-app-password
EMAIL_FROM_NAME=Flutter LMS
EMAIL_FROM_ADDRESS=your-email@gmail.com


# Set true after creating a Cloudinary account.
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
CLOUDINARY_FOLDER=flutter-lms/profile-images
PROFILE_IMAGE_MAX_MB=5

# Used only by npm run seed:admin
ADMIN_SEED_FIRST_NAME=System
ADMIN_SEED_LAST_NAME=Administrator
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=AdminPassword123!
