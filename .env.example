NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Atlas connection information
# Replace the username, password and cluster hostname.
MONGODB_URI=mongodb+srv://lms_app_user:ENCODED_PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=FlutterLMS
MONGODB_DB_NAME=flutter_lms
MONGODB_MAX_POOL_SIZE=10

# Use * during early mobile-app development.
# For a future web admin application, list accepted origins with commas.
CORS_ORIGINS=*

LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=10000